{
    "manifest_version": 3,
    "name": "Clark College Events",
    "description": "A list of events taking place today and tomorrow at Clark College",
    "version": "1.7.3",
    "icons": {
        "128": "images/logo.png"
    },
    "action": {
        "default_icon": "images/logo.png",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "js/service-worker.js",
        "scripts": [
            "js/service-worker.js"
        ]
    },
    "host_permissions": [
        "https://25livepub.collegenet.com/*"
    ],
    "permissions": [
        "storage",
        "webRequest",
        "webRequestBlocking"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "clark-college-events@clark.edu",
            "strict_min_version": "109.0"
        }
    }
}